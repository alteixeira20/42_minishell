# ========================
# Echo Command & Quoting
# ========================
echo Hello World 42
echo "hello    world"
echo 'Hello World'
echo 'Hello World' # shouldn't be printed
echo Hello World # shouldn't be printed
echo "hello "'world'
echo >
echo hi >
echo hi >>
echo hi <
echo hi <<
echo $HOME
echo "$HOME"
echo '$HOME'
echo "$7asdfsasdf"
echo "Hello $USER"
echo '$USER "$HOME"'
echo "$USER $HOME"
echo "user is $USER and home is $HOME"
echo $USER!
echo ""$USER""
echo "hello | world"
echo $
echo "$"
echo "aspas ->'"
echo " | $"
echo <missing <"./test_files/infile" <missing
echo <123 <456 hi
echo | ""
echo <"./test_files/infile" <missing <"./test_files/infile"

# ========================
# Redirection with files
# ========================
echo before > tmp_test.txt
ls tmp_test.txt
cat < tmp_test.txt
echo another >> tmp_test.txt
cat < tmp_test.txt
rm tmp_test.txt

# Redirection edge cases
echo first > file > file2
cat < file2
rm file file2

echo one>space.txt
echo two >>space.txt
cat <space.txt
chmod 000 space.txt
cat space.txt
chmod 644 space.txt
./space.txt
rm space.txt

cd tester/
ls -l
cat <"./test_files/small_file" | echo 42
cat <"./test_files/big_file" | echo 42

# ========================
# Environment
# ========================
export
export VAR=42
echo $VAR
env
env | grep VAR
env | sort | grep -v SHLVL | grep -v ^_
export PATH=/tmp
echo $PATH

# ========================
# Builtins & Commands
# ========================
ls
ls -la
/bin/ls
/bin/echo hello from bin
/bin/cat /etc/passwd | head -n 2
ls | wc
ls >./outfiles/outfile01 >>./test_files/invalid_permission >>./outfiles/outfile02
touch is_file
cd is_file
rm is_file
mkdir -p is_folder
cd is_folder
cd ..
ls | grep is_folder
chmod 000 is_folder
cd is_folder
chmod 777 is_folder
rm -rf is_folder
cd doesntexit

# ========================
# Pipes & Execution
# ========================
echo hello | cat
echo one | echo two | echo three
echo piped | grep pipe
echo part1 | cat | wc
env | sort | grep -v SHLVL | grep -v ^_
export PIPETEST=42 | env | grep PIPETEST
cat export | grep PIPETEST
cat <"./tester/test_files/small_file" | grep 42
cat <"./tester/test_files/big_file" | grep oi
yes | echo Hi

